SPRING_PROFILES_ACTIVE=production
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=20.0 -XX:MaxRAMPercentage=60.0 -XX:+ExitOnOutOfMemoryError

DATABASE_URL=jdbc:postgresql://<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=tutor_base_app.<project-ref>
DATABASE_PASSWORD=
DATABASE_MIGRATIONS_ENABLED=false
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=0
DATABASE_CONNECTION_TIMEOUT_MS=5000

TUTOR_CSRF_SECRET=<至少32字节随机值>
TUTOR_SESSION_LIFETIME=PT12H
TUTOR_WEB_ALLOWED_ORIGINS=https://staging-learn.be-young.top
TUTOR_PUBLIC_MUTATION_LIMIT=10
TUTOR_PUBLIC_MUTATION_WINDOW=PT1M
TUTOR_BOOTSTRAP_ENABLED=false
TUTOR_BOOTSTRAP_USERNAME=young
TUTOR_BOOTSTRAP_PASSWORD=

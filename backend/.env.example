# 本文件只提供本地开发示例。复制为 .env 后填写；不要提交真实密码或生产密钥。
DATABASE_URL=jdbc:postgresql://localhost:5432/tutor_base_dev
DATABASE_USERNAME=tutor_base_dev
DATABASE_PASSWORD=local-dev-password
DATABASE_MIGRATIONS_ENABLED=true

DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=0
DATABASE_CONNECTION_TIMEOUT_MS=5000

TUTOR_CSRF_SECRET=local-development-only-change-before-production
TUTOR_SESSION_LIFETIME=PT12H
TUTOR_SESSION_COOKIE_NAME=TUTOR_SESSION
TUTOR_SESSION_COOKIE_SECURE=false
TUTOR_PUBLIC_MUTATION_LIMIT=10
TUTOR_PUBLIC_MUTATION_WINDOW=PT1M
TUTOR_WEB_ALLOWED_ORIGINS=http://localhost:3000

# 管理员自举默认关闭。只有执行一次性自举手册时才临时启用。
TUTOR_BOOTSTRAP_ENABLED=false
TUTOR_BOOTSTRAP_USERNAME=young
TUTOR_BOOTSTRAP_PASSWORD=
